{
  "name": "kadr",
  "version": "0.7.1",
  "description": "Kadr — GPU-accelerated multi-track video editor with Codex and MCP integration",
  "main": "out/main/main.js",
  "author": "Black Triangle",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node scripts/test.mjs",
    "test:media": "node scripts/test.mjs --media",
    "verify": "npm run typecheck && npm test && npm run build",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "fflate": "^0.8.3",
    "meshoptimizer": "^1.3.0",
    "mp4-muxer": "^5.1.5",
    "mp4box": "^2.3.0",
    "node-pty": "^1.1.0",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.11.18",
    "electron-vite": "^5.0.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.7"
  },
  "contributors": [
    "Claude (Anthropic)"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ustniyart-dotcom/kadr-for-codex.git"
  }
}
